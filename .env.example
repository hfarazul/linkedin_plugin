# Choose ONE backend: playwright or unipile
LINKEDIN_BACKEND=playwright

# --- Playwright backend ---
# After logging into LinkedIn once via `python -m linkedin_agent auth`,
# session state is stored at playwright_state/state.json. Nothing else needed.

# --- Unipile backend ---
# Sign up at unipile.com, connect your LinkedIn account, grab the API key + account ID.
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
UNIPILE_DSN=api.unipile.com:13xxx

# --- Safety / rate limits (per 24h rolling window) ---
DAILY_MAX_REACTIONS=30
DAILY_MAX_CONNECTIONS=20
DAILY_MAX_DMS=10
DAILY_MAX_SEARCHES=50

# Min/max delay between actions, seconds. Randomized within range.
ACTION_DELAY_MIN=30
ACTION_DELAY_MAX=90

# DRY_RUN=1 means tools log intent but never call LinkedIn.
DRY_RUN=0

# 24/7 mode — set to 1 to remove the 9-5 Mon-Fri send window. Default
# (0/unset) is windowed for lower LinkedIn detection risk; flip to 1 only
# if you've decided the always-on tradeoff is worth it.
LINKEDIN_DISABLE_SEND_WINDOW=0

# --- Provider routing (capability-based) ---
# PhantomBuster is the only provider. Unipile was removed after its
# connected LinkedIn account was disconnected (401 errors/disconnected_account);
# LINKEDIN_FALLBACK_PROVIDER is retained for a future second provider and
# should be left empty.
LINKEDIN_PRIMARY_PROVIDER=phantombuster
LINKEDIN_FALLBACK_PROVIDER=

# --- PhantomBuster ---
PHANTOMBUSTER_API_KEY=
# Agent ids from your PhantomBuster workspace (Phantom -> Settings -> API).
PHANTOMBUSTER_AGENT_PROFILE_SCRAPER=
PHANTOMBUSTER_AGENT_INBOX_SCRAPER=
PHANTOMBUSTER_AGENT_SEARCH_EXPORT=
PHANTOMBUSTER_AGENT_ACTIVITY_EXTRACTOR=
PHANTOMBUSTER_AGENT_AUTO_LIKER=
PHANTOMBUSTER_AGENT_AUTO_CONNECT=
PHANTOMBUSTER_AGENT_MESSAGE_SENDER=
# Capabilities whose PhantomBuster output has NOT been verified are disabled by
# default so an untested Phantom cannot reach real prospects. Opt in per
# capability once its verification task passes, e.g.:
#   PHANTOMBUSTER_ENABLE_UNVERIFIED=search_people,recent_posts
PHANTOMBUSTER_ENABLE_UNVERIFIED=
